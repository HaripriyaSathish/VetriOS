SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — VetriOSDB (shared, over Tailscale)
DB_NAME=VetriOSDB
DB_USER=vetri_app_role
DB_PASSWORD=
DB_HOST=100.94.127.20
DB_PORT=5432

# Groq — used by the AI assistants and the Document Generator
GROQ_API_KEY=

# CORS — your Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Uploads are saved in backend/media/ and served at <BACKEND_URL>/media/
BACKEND_URL=http://localhost:8000

# Cloudinary — no longer used for storage. Only needed once, to run
# `python manage.py copy_cloudinary_to_media` for files uploaded before the switch.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Outlook/Office 365 (module_07_email)
OUTLOOK_EMAIL_HOST=smtp-mail.outlook.com
OUTLOOK_EMAIL_PORT=587
OUTLOOK_EMAIL_USE_TLS=True
OUTLOOK_EMAIL_HOST_USER=
OUTLOOK_EMAIL_HOST_PASSWORD=
